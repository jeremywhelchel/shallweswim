# None of the bucket variables below are needed to run the app locally:
# `uv run python -m shallweswim.local` sets all three itself, to a directory or
# to process memory, and overrides whatever this file leaves in the shell.
#
# Optional for local NWIS testing. If omitted, USGS Water Data API requests are
# sent unauthenticated.
USGS_WATERDATA_API_KEY=

# Private observation archive bucket (name only, no gs:// prefix) that the
# scheduled Cloud Run capture job writes to. build_and_deploy.sh requires it
# and refuses to deploy when it is unset or empty. Leave empty for local runs;
# an empty value simply disables capture there.
SHALLWESWIM_ARCHIVE_BUCKET=

# Optional, local development only. Bucket name (no gs:// prefix) to hydrate
# historical temperature years from the archive instead of refetching them from
# the provider on every local start. It requires only bucket read access and
# never enables writes; capture stays off unless SHALLWESWIM_ARCHIVE_BUCKET is
# set. The web service manifest never sets this variable; the capture job sets
# it to its archive bucket when publishing snapshots.
SHALLWESWIM_ARCHIVE_READ_BUCKET=

# Required by `python -m shallweswim.main`, the web service. Bucket name (no
# gs:// prefix), or a path containing "/", whose published/ prefix holds the
# serving snapshots the capture job publishes. The web service serves every
# request from the current generation and fetches nothing, so it fails at
# startup without this. It requires only bucket read access
# (roles/storage.objectViewer) and never writes. Leave it empty here:
# `python -m shallweswim.local` sets it to its own local store, and the
# deployed service gets it from service.yaml.
SHALLWESWIM_SNAPSHOT_READ_BUCKET=

# Deployment-local name of the private, versioned GCS bucket used for
# Terraform state. The bucket name is not secret, but differs per installation.
SHALLWESWIM_TERRAFORM_STATE_BUCKET=

# Path to the dedicated Terraform operator service-account credential. Do not
# reuse the Cloud Run runtime or ordinary deployment credential.
SHALLWESWIM_TERRAFORM_CREDENTIALS=
