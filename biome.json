{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "files": {
    "includes": [
      "**",
      "!frontend/openapi.json",
      "!frontend/pnpm-lock.yaml",
      "!frontend/src/api/generated.ts",
      "!frontend/dist",
      "!frontend/node_modules",
      "!frontend/test-results",
      "!frontend/playwright-report"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noUnknownAtRules": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["frontend/src/**/*.test.{ts,tsx}"],
      "linter": {
        "domains": {
          "playwright": "none"
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "markdown": {
    "formatter": {
      "enabled": false
    },
    "linter": {
      "enabled": false
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
