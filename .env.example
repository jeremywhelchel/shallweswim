# Optional for local NWIS testing. If omitted, USGS Water Data API requests are
# sent unauthenticated.
USGS_WATERDATA_API_KEY=

# Deployment-local name of the private, versioned GCS bucket used for
# Terraform state. The bucket name is not secret, but differs per installation.
SHALLWESWIM_TERRAFORM_STATE_BUCKET=

# Path to the dedicated Terraform operator service-account credential. Do not
# reuse the Cloud Run runtime or ordinary deployment credential.
SHALLWESWIM_TERRAFORM_CREDENTIALS=
